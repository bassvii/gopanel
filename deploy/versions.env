# Версии и хеши внешних компонентов, которые качает install.sh.
#
# При обновлении:
#   1. Взять новый тег с https://github.com/XTLS/Xray-core/releases
#   2. Скачать .dgst с той же страницы и сравнить SHA2-256
#   3. Обновить XRAY_VERSION и XRAY_SHA256_* ниже
#   4. Закоммитить
#
# ВАЖНО: geosite/geoip (Loyalsoldier) фиксируются по тегу GEO_TAG
# ниже и проверяются по SHA-256. Не менять на releases/latest:
# latest не даёт воспроизводимости и позволяет upstream-компрометацию
# подсунуть любой файл.

# --- Xray-core ---

XRAY_VERSION="v26.3.27"

# SHA-256 для Xray-linux-64.zip
XRAY_SHA256_AMD64="23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae"

# SHA-256 для Xray-linux-arm64-v8a.zip
XRAY_SHA256_ARM64="4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c"


# --- GeoIP/GeoSite (Loyalsoldier/v2ray-rules-dat) ---
#
# Формат тега: YYYYMMDDHHMM (например 202610132205).
# Обновлять вручную раз в 1–3 месяца: взять свежий тег с
# https://github.com/Loyalsoldier/v2ray-rules-dat/releases
# и обновить хеши через:
#   curl -fsSL -o /tmp/geosite.dat \
#     "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/<TAG>/geosite.dat"
#   sha256sum /tmp/geosite.dat

GEO_TAG="202610132205"

# SHA-256 для geosite.dat и geoip.dat этого релиза.
# Заполняются при обновлении GEO_TAG.
GEO_SHA256_GEOSITE="c5a73fbd415bb0506ecf8fa574caadc6f54a71d9308c265e97da49e4cebf8466"
GEO_SHA256_GEOIP="116cc0f03d48991962f7f9cdbbcf53d45d89777f9c3cd1a663210853e5df6093"
