# Версии и хеши внешних компонентов, которые качает install.sh.
#
# При обновлении:
#   1. Взять новый тег с https://github.com/XTLS/Xray-core/releases
#   2. Скачать .dgst с той же страницы и сравнить SHA2-256
#   3. Обновить XRAY_VERSION и XRAY_SHA256_* ниже
#   4. Закоммитить
#
# ВАЖНО: geosite/geoip (Loyalsoldier) здесь пока не фиксируются:
# у них нет версионированных URL, только releases/latest/download.
# Это отдельная задача (см. аудит P0-3).

# --- Xray-core ---

XRAY_VERSION="v26.3.27"

# SHA-256 для Xray-linux-64.zip
XRAY_SHA256_AMD64="23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae"

# SHA-256 для Xray-linux-arm64-v8a.zip
XRAY_SHA256_ARM64="4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c"
